package com.example.demo.auth;

import com.example.demo.IntegrationTest;
import com.example.demo.auth.dto.AuthResponse;
import com.example.demo.auth.dto.LoginRequest;
import com.example.demo.auth.dto.RegisterRequest;
import com.example.demo.bookmark.BookmarkRepository;
import com.example.demo.tag.TagRepository;
import com.example.demo.user.UserRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.web.server.LocalServerPort;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.client.RestTestClient;

import static org.assertj.core.api.Assertions.assertThat;

@IntegrationTest
class AuthIntegrationIT {

    @LocalServerPort
    private int port;

    @Autowired private UserRepository userRepository;
    @Autowired private BookmarkRepository bookmarkRepository;
    @Autowired private TagRepository tagRepository;

    private RestTestClient client;

    @BeforeEach
    void setUp() {
        bookmarkRepository.deleteAll();
        tagRepository.deleteAll();
        userRepository.deleteAll();

        client = RestTestClient.bindToServer()
                .baseUrl("http://localhost:" + port)
                .build();
    }

    @Test
    void registerThenLoginThenAccessProtectedEndpoint() {
        var registerReq = new RegisterRequest("new@example.com", "password123", "New User");

        AuthResponse registerRes = client.post()
                .uri("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .body(registerReq)
                .exchange()
                .expectStatus().isCreated()
                .expectBody(AuthResponse.class)
                .returnResult()
                .getResponseBody();

        assertThat(registerRes).isNotNull();
        assertThat(registerRes.token()).isNotBlank();

        var loginReq = new LoginRequest("new@example.com", "password123");
        AuthResponse loginRes = client.post()
                .uri("/api/auth/login")
                .contentType(MediaType.APPLICATION_JSON)
                .body(loginReq)
                .exchange()
                .expectStatus().isOk()
                .expectBody(AuthResponse.class)
                .returnResult()
                .getResponseBody();

        assertThat(loginRes).isNotNull();
        String loginToken = loginRes.token();
        assertThat(loginToken).isNotBlank();

        client.get()
                .uri("/api/bookmarks")
                .exchange()
                .expectStatus().isUnauthorized();

        client.get()
                .uri("/api/bookmarks")
                .header("Authorization", "Bearer " + loginToken)
                .exchange()
                .expectStatus().isOk();
    }

    @Test
    void registerRejectsDuplicateEmail() {
        var req = new RegisterRequest("dup@example.com", "password123", "Dup");
        client.post()
                .uri("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .body(req)
                .exchange()
                .expectStatus().isCreated();

        var req2 = new RegisterRequest("dup@example.com", "password456", "Dup2");
        client.post()
                .uri("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .body(req2)
                .exchange()
                .expectStatus().isEqualTo(HttpStatus.CONFLICT);
    }

    @Test
    void loginRejectsWrongPassword() {
        var registerReq = new RegisterRequest("user@example.com", "correct", "User");
        client.post()
                .uri("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .body(registerReq)
                .exchange()
                .expectStatus().isCreated();

        var loginReq = new LoginRequest("user@example.com", "wrong");
        client.post()
                .uri("/api/auth/login")
                .contentType(MediaType.APPLICATION_JSON)
                .body(loginReq)
                .exchange()
                .expectStatus().isUnauthorized();
    }

    @Test
    void userACannotSeeUserBBookmarks() {
        var aliceReg = new RegisterRequest("alice@example.com", "password123", "Alice");
        AuthResponse aliceAuth = client.post()
                .uri("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .body(aliceReg)
                .exchange()
                .expectStatus().isCreated()
                .expectBody(AuthResponse.class)
                .returnResult()
                .getResponseBody();

        String bookmarkJson = """
                {
                    "title": "Alice Bookmark",
                    "url": "https://alice.example.com",
                    "description": "",
                    "tags": []
                }
                """;
        client.post()
                .uri("/api/bookmarks")
                .header("Authorization", "Bearer " + aliceAuth.token())
                .contentType(MediaType.APPLICATION_JSON)
                .body(bookmarkJson)
                .exchange()
                .expectStatus().isCreated();

        var bobReg = new RegisterRequest("bob@example.com", "password123", "Bob");
        AuthResponse bobAuth = client.post()
                .uri("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .body(bobReg)
                .exchange()
                .expectStatus().isCreated()
                .expectBody(AuthResponse.class)
                .returnResult()
                .getResponseBody();

        String bobListBody = client.get()
                .uri("/api/bookmarks")
                .header("Authorization", "Bearer " + bobAuth.token())
                .exchange()
                .expectStatus().isOk()
                .expectBody(String.class)
                .returnResult()
                .getResponseBody();

        assertThat(bobListBody).doesNotContain("Alice Bookmark");
        assertThat(bobListBody).contains("\"totalElements\":0");
    }
}